ent:
comp: window_t

ent:
comp: render_object_t
str: mesh "assets/models/backpack.obj"
str: vertex_shader "assets/shaders/texture.vs"
str: fragment_shader "assets/shaders/test.fs"
comp: z_pre_pass_t
str: vertex_shader "assets/shaders/texture.vs"
comp: transform_t
f32: pos [0 0 0]
f32: rot [0 0 0]
f32: scale [1 1 1]
comp: textures_t
str: names ["diffuse" "ao" "specular"]
str: textures ["assets/textures/diffuse.jpg" "assets/textures/ao.jpg" "assets/textures/specular.jpg"]

ent:
comp: point_light_t
f32: colour [1 1 1]
f32: intensity 1.0
comp: transform_t
f32: pos [2 2 2]
f32: rot [0 0 0]
f32: scale [1 1 1]

ent:
comp: point_light_t
f32: colour [0.5 0 0]
f32: intensity 1.0
comp: transform_t
f32: pos [0 10 0]
f32: rot [0 0 0]
f32: scale [1 1 1]

ent:
comp: point_light_t
f32: colour [0 0 0.25]
f32: intensity 1.0
comp: transform_t
f32: pos [5 10 1]
f32: rot [0 0 0]
f32: scale [1 1 1]

ent:
comp: camera_t
f32: fov 45.0
f32: aspect_ratio 1.777777778
f32: near 0.01
f32: far 1000
comp: transform_t
f32: pos [0 0 10]
f32: rot [0 0 0]
f32: scale [1 1 1]
